{
  "components": {
    "schemas": {
      "WalletPaymentChallengeRequest": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "Address",
            "type": "string"
          },
          "chain_id": {
            "title": "Chain Id",
            "type": "integer"
          }
        },
        "required": [
          "address",
          "chain_id"
        ],
        "title": "ChallengeRequest",
        "type": "object"
      },
      "WalletPaymentHTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/WalletPaymentValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "WalletPaymentPayoutChallenge": {
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "chain_id": {
            "title": "Chain Id",
            "type": "integer"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "nonce": {
            "title": "Nonce",
            "type": "string"
          }
        },
        "required": [
          "nonce",
          "message",
          "address",
          "chain_id"
        ],
        "title": "PayoutChallenge",
        "type": "object"
      },
      "WalletPaymentRegisteredDestination": {
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "chain_id": {
            "title": "Chain Id",
            "type": "integer"
          },
          "host_org_id": {
            "format": "uuid",
            "title": "Host Org Id",
            "type": "string"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          },
          "verified_at": {
            "format": "date-time",
            "title": "Verified At",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "host_org_id",
          "address",
          "chain_id",
          "verified_at"
        ],
        "title": "RegisteredDestination",
        "type": "object"
      },
      "WalletPaymentSubmitRequest": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "nonce": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Nonce",
            "type": "string"
          },
          "signature": {
            "maxLength": 32770,
            "minLength": 4,
            "pattern": "^0x[0-9a-fA-F]+$",
            "title": "Signature",
            "type": "string"
          }
        },
        "required": [
          "nonce",
          "message",
          "signature"
        ],
        "title": "SubmitRequest",
        "type": "object"
      },
      "WalletPaymentUsdcLeasePaymentCreate": {
        "additionalProperties": false,
        "description": "POST /payments/usdc/lease-payments\n\nOpens a pending USDC payment for one lease. The price clears 1:1 from\nUSD cents into USDC atoms. No card is involved.",
        "properties": {
          "amount_cents": {
            "description": "Total USD cents: $0.50\u2013$10,000.00 inclusive",
            "maximum": 1000000.0,
            "minimum": 50.0,
            "title": "Amount Cents",
            "type": "integer"
          },
          "listing_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Marketplace listing this payment buys. The server writes it to billing extra_metadata.listing_id, which marketplace purchase checks. A listing_id key in metadata is ignored.",
            "title": "Listing Id"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional string map copied onto billing extra_metadata. Platform keys tenant_id and payment_rail win. lease_id and listing_id from a browser client are ignored. Do not send secrets.",
            "title": "Metadata"
          }
        },
        "required": [
          "amount_cents"
        ],
        "title": "UsdcLeasePaymentCreate",
        "type": "object"
      },
      "WalletPaymentValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WalletPaymentWalletCapabilities": {
        "additionalProperties": false,
        "properties": {
          "accounting_effect": {
            "const": "confirmed_capacity_only",
            "default": "confirmed_capacity_only",
            "title": "Accounting Effect",
            "type": "string"
          },
          "checkout_creation": {
            "title": "Checkout Creation",
            "type": "boolean"
          },
          "contract_version": {
            "const": "wallet-payments/v1",
            "default": "wallet-payments/v1",
            "title": "Contract Version",
            "type": "string"
          },
          "deposit_creation": {
            "title": "Deposit Creation",
            "type": "boolean"
          },
          "deposit_observation": {
            "const": true,
            "default": true,
            "title": "Deposit Observation",
            "type": "boolean"
          },
          "enterprise_units_redeemable": {
            "const": false,
            "default": false,
            "title": "Enterprise Units Redeemable",
            "type": "boolean"
          },
          "mode": {
            "const": "sandbox",
            "default": "sandbox",
            "title": "Mode",
            "type": "string"
          },
          "payout_address_proof": {
            "title": "Payout Address Proof",
            "type": "boolean"
          },
          "production_payments": {
            "const": false,
            "default": false,
            "title": "Production Payments",
            "type": "boolean"
          },
          "refund_recovery": {
            "const": "owner_managed",
            "default": "owner_managed",
            "title": "Refund Recovery",
            "type": "string"
          },
          "settlement_authority": {
            "const": "verified_provider_confirmation",
            "default": "verified_provider_confirmation",
            "title": "Settlement Authority",
            "type": "string"
          },
          "usdc_host_enrollment": {
            "title": "Usdc Host Enrollment",
            "type": "boolean"
          }
        },
        "required": [
          "checkout_creation",
          "deposit_creation",
          "payout_address_proof",
          "usdc_host_enrollment"
        ],
        "title": "WalletCapabilities",
        "type": "object"
      },
      "WalletPaymentWalletCheckoutResponse": {
        "properties": {
          "billing_record_id": {
            "format": "uuid",
            "title": "Billing Record Id",
            "type": "string"
          },
          "checkout_url": {
            "title": "Checkout Url",
            "type": "string"
          }
        },
        "required": [
          "billing_record_id",
          "checkout_url"
        ],
        "title": "WalletCheckoutResponse",
        "type": "object"
      },
      "WalletPaymentWalletDepositStatus": {
        "additionalProperties": false,
        "description": "USD-priced sandbox observation; never an enterprise balance.",
        "properties": {
          "amount_cents": {
            "title": "Amount Cents",
            "type": "integer"
          },
          "billing_record_id": {
            "format": "uuid",
            "title": "Billing Record Id",
            "type": "string"
          },
          "chain_id": {
            "const": 84532,
            "default": 84532,
            "title": "Chain Id",
            "type": "integer"
          },
          "currency": {
            "const": "usd",
            "default": "usd",
            "title": "Currency",
            "type": "string"
          },
          "deposit_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deposit Address"
          },
          "lease_id": {
            "format": "uuid",
            "title": "Lease Id",
            "type": "string"
          },
          "network": {
            "const": "base",
            "default": "base",
            "title": "Network",
            "type": "string"
          },
          "payer_mismatch": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer Mismatch"
          },
          "provider_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Status"
          },
          "settled": {
            "title": "Settled",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "token_contract_address": {
            "const": "0x036cbd53842c5426634e7929541ec2318f3dcf7e",
            "default": "0x036cbd53842c5426634e7929541ec2318f3dcf7e",
            "title": "Token Contract Address",
            "type": "string"
          },
          "token_currency": {
            "const": "usdc",
            "default": "usdc",
            "title": "Token Currency",
            "type": "string"
          }
        },
        "required": [
          "billing_record_id",
          "lease_id",
          "status",
          "provider_status",
          "settled",
          "deposit_address",
          "amount_cents"
        ],
        "title": "WalletDepositStatus",
        "type": "object"
      },
      "WalletPaymentWalletLeasePaymentResponse": {
        "properties": {
          "amount_cents": {
            "title": "Amount Cents",
            "type": "integer"
          },
          "billing_record_id": {
            "format": "uuid",
            "title": "Billing Record Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "billing_record_id",
          "status",
          "amount_cents"
        ],
        "title": "WalletLeasePaymentResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Tenant-session JWT after switch-tenant, or a gateway-minted API-key exchange JWT (purpose=service or org-admin renter key). X-Tenant-ID must match the tenant claim. Not raw Keycloak. Not a pasted or KV-stashed portal JWT.",
        "scheme": "bearer",
        "type": "http"
      },
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Wallet payment owner contract",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/payments/host-payout-address": {
      "post": {
        "operationId": "submit_api_v1_payments_host_payout_address_post",
        "parameters": [
          {
            "description": "Must match the browser tenant session",
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WalletPaymentSubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentRegisteredDestination"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentHTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Submit",
        "tags": [
          "WalletPayments"
        ]
      }
    },
    "/api/v1/payments/host-payout-address/challenge": {
      "post": {
        "operationId": "challenge_api_v1_payments_host_payout_address_challenge_post",
        "parameters": [
          {
            "description": "Must match the browser tenant session",
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WalletPaymentChallengeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentPayoutChallenge"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentHTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Challenge",
        "tags": [
          "WalletPayments"
        ]
      }
    },
    "/api/v1/payments/wallet/capabilities": {
      "get": {
        "operationId": "get_wallet_payment_capabilities",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentWalletCapabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "BearerAuth": []
          }
        ],
        "summary": "Wallet Capabilities",
        "tags": [
          "WalletPayments"
        ]
      }
    },
    "/api/v1/payments/wallet/lease-payments": {
      "post": {
        "operationId": "create_wallet_lease_payment",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Reuse the same UUID when retrying the same payment request.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WalletPaymentUsdcLeasePaymentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentWalletLeasePaymentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentHTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create Usdc Lease Payment Route",
        "tags": [
          "WalletPayments"
        ]
      }
    },
    "/api/v1/payments/wallet/lease-payments/{billing_record_id}/checkout": {
      "post": {
        "operationId": "create_wallet_checkout",
        "parameters": [
          {
            "in": "path",
            "name": "billing_record_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Billing Record Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentWalletCheckoutResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentHTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "BearerAuth": []
          }
        ],
        "summary": "Open Stablecoin Checkout",
        "tags": [
          "WalletPayments"
        ]
      }
    },
    "/api/v1/payments/wallet/lease-payments/{billing_record_id}/deposit": {
      "get": {
        "operationId": "get_wallet_deposit",
        "parameters": [
          {
            "in": "path",
            "name": "billing_record_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Billing Record Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentWalletDepositStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentHTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "BearerAuth": []
          }
        ],
        "summary": "Deposit Status",
        "tags": [
          "WalletPayments"
        ]
      },
      "post": {
        "operationId": "create_wallet_deposit",
        "parameters": [
          {
            "in": "path",
            "name": "billing_record_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Billing Record Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentWalletDepositStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPaymentHTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create Deposit",
        "tags": [
          "WalletPayments"
        ]
      }
    }
  }
}
